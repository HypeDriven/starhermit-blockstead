{
  "name": "blockstead",
  "version": "1.0.0",
  "private": true,
  "description": "Blockstead — gather resources and build a voxel settlement in a sunny valley, on the StarHermit engine.",
  "scripts": {
    "test": "npm run test:unit && npm run test:native",
    "test:unit": "node tests/run-tests.js && node --test tests/migrate.test.js tests/i18n.test.js",
    "test:native": "node tests/native.mjs",
    "test:browser": "node tools/browser-play.mjs .",
    "package": "node tools/package-web.mjs",
    "css": "node tools/css.mjs",
    "plan": "node tools/plan.mjs",
    "start": "node server.js"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
